@inproceedings{DesigningImpairedTechnologies,
  selected = {false},
  abbr = {CHI Play},
  preview = {impaired_tech.png},
  google_scholar_id = {9yKSN-GCB0IC},
  bibtex_show = {true},
  title = {Designing with {{Impaired Technologies}}: {{A Game Jam}} of {{Constraints}} and {{Affordance Shrinkage}}},
  shorttitle = {Designing with {{Impaired Technologies}}},
  booktitle = {Companion {{Proceedings}} of the {{Annual Symposium}} on {{Computer-Human Interaction}} in {{Play}}},
  author = {Lo, Priscilla Y. and Stangroome, Grace Jane and Joshi, Vishal and Burnett, Jack and Thue, David and Bennett, Dan and Metatla, Oussama},
  year = 2026,
  month = nov,
  series = {{{CHI PLAY Companion}} '26},
  pages = {66--73},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3800965.3834287},
  urldate = {2026-10-27},
  abstract = {Playing under constraint, whether due to disability, financial limitations, technological obsolescence, or other factors, is a widespread but under-examined aspect of gaming culture. We introduce ``impaired technologies'' (damaged peripherals such as cracked screens, controllers with missing buttons, and faulty speakers) as design provocations to explore what happens when the affordances available for play ``shrink.'' Drawing on Dokumaci's concepts of ``affordance shrinkage'' and ``activist affordances,'' we hosted a two-day public game jam where participants (n=9) first played existing games on impaired technologies, then designed their own games inspired by the experience. We identified six adaptive play strategies improvised under constraint, and three design themes, transforming ``bugs'' into features, embedding constraint within gameplay, and prioritizing fun over challenge. Our findings position constrained play as a site of creativity and agency, with implications for accessibility, jank, sub-optimal hardware gaming, and inclusive design.},
  isbn = {979-8-4007-2565-4},
  keywords = {accessibility,adaptive,game design,game jam,impairment,inclusion,play styles}
}

