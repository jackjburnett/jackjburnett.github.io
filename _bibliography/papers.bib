  urldate = {2026-10-27},
  abstract = {Platform standardisation improves accessibility across contemporary gaming ecosystems, but it also shapes which forms of accessible play are recognised as legitimate. This Perspectives on Play paper introduces the accessibility paradox of platform standardisation: the same infrastructures that support accessibility can constrain adaptation and community-led solutions. I argue that accessibility is not solely a technical challenge but also a question of authority, legitimacy, and governance.},
