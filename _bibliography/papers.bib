  bibtex_show = {true},
  title = {The {{Accessibility Paradox}}: {{Platform Standardisation}} and the {{Legitimacy}} of {{Play}}},
  shorttitle = {The {{Accessibility Paradox}}},
  booktitle = {Companion {{Proceedings}} of the {{Annual Symposium}} on {{Computer-Human Interaction}} in {{Play}}},
  author = {Burnett, Jack},
  year = 2026,
  month = nov,
  series = {{{CHI PLAY Companion}} '26},
  pages = {492--495},
  publisher = {Association for Computing Machinery},
