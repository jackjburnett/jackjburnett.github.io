@inproceedings{PlayingWithConstraints,
  selected = {false},
  website = {https://biglab.co.uk/event/playing-with-constraints-designing-inclusive-games/},
  abbr = {CHI Play},
  preview = {playing_with_constraints.jpeg},
  google_scholar_id = {d1gkVwhDpl0C},
  bibtex_show = {true},
  title = {Playing with {{Constraints}}: {{Designing Inclusive Games}} and {{Controllers}}},
  shorttitle = {Playing with {{Constraints}}},
  booktitle = {Companion {{Proceedings}} of the {{Annual Symposium}} on {{Computer-Human Interaction}} in {{Play}}},
  author = {Lo, Priscilla Y. and Stangroome, Grace and Joshi, Vishal and Burnett, Jack and Thue, David and Metatla, Oussama},
  year = 2026,
  month = nov,
  series = {{{CHI PLAY Companion}} '26},
  pages = {573--575},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3800965.3834573},
  urldate = {2026-10-27},
  abstract = {How can we design inclusive games that appeal to gamers with different abilities? This workshop invites the CHI PLAY community to play with constraints and conceptualize games that enable forms of play beyond conventional patterns. We build on our prior work that applies the concept of ``impaired technologies'' as a design provocation in a game jam to encourage alternative perspectives on play. Participants will create multiplayer games that are played with impaired technologies or, as an extension, that use novel interactions. We aim to engage researchers and practitioners interested in designing playful prototypes, including digital games, immersive experiences, tangible toys, and game controllers.},
  isbn = {979-8-4007-2565-4},
  keywords = {accessibility,game jam,inclusion,playful embodiment}
}

